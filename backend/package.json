{
  "name": "ghoralantinu-backend",
  "version": "0.0.1",
  "description": "ghoralantinu backend service",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --max-warnings 0",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "NODE_ENV=test jest --forceExit --runInBand --no-watchman",
    "test:e2e": "NODE_ENV=test jest --forceExit --runInBand",
    "test:watch": "jest --watch",
    "migrate": "knex migrate:latest --knexfile knexfile.ts",
    "migrate:rollback": "knex migrate:rollback --knexfile knexfile.ts",
    "seed": "knex seed:run --knexfile knexfile.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.0",
    "express": "4.18.2",
    "jsonwebtoken": "^9.0.3",
    "knex": "3.1.0",
    "pg": "^8.23.0",
    "postgres": "3.4.4",
    "typescript": "5.3.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "20.10.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "6.17.0",
    "@typescript-eslint/parser": "6.17.0",
    "eslint": "8.56.0",
    "jest": "^30.5.1",
    "prettier": "3.1.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "10.9.2"
  }
}
