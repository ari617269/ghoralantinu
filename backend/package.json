{
  "name": "ghoralantinu-backend",
  "version": "0.0.1",
  "description": "ghoralantinu backend service",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --max-warnings 0",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "test:e2e": "ts-node tests/e2e/runner.ts"
  },
  "dependencies": {
    "express": "4.18.2",
    "postgres": "3.4.4",
    "knex": "3.1.0",
    "typescript": "5.3.3"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "20.10.6",
    "ts-node": "10.9.2",
    "eslint": "8.56.0",
    "@typescript-eslint/eslint-plugin": "6.17.0",
    "@typescript-eslint/parser": "6.17.0",
    "prettier": "3.1.1"
  }
}
